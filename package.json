{
  "name": "the-last-train",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "test:desktop": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.8",
    "vite": "^6.3.5"
  },
  "main": "electron/main.cjs",
  "description": "A cinematic 3D detective mystery aboard the Montclair Express",
  "author": "The Last Train contributors"
}
